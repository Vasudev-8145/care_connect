
#===========DOCTOR=============

# api call for listing doctor details
###
GET http://127.0.0.1:8000/doctors/
Accept: application/json

# api call for creating doctor details
###
POST http://127.0.0.1:8000/doctors/
Content-Type: application/json

{
    "name":"Ajna",
    "specialization":"ent",
    "fee":500,
    "qualification":"MBBS",
    "email":"ajna@gmail.com"
}

# api call for listing one doctor details
###
GET http://127.0.0.1:8000/doctors/1/
Accept: application/json

# api call for updating doctor details
###
put http://127.0.0.1:8000/doctors/3/
Content-Type: application/json

{
    "name":"peethambaran",
    "specialization":"ent",
    "fee":550,
    "qualification":"MBBS",
    "email":"peethambaran@gmail.com"
}

# api call for deleting one doctor details
###
DELETE http://127.0.0.1:8000/doctors/2/
Accept: application/json

##### v2 end points ######

# api call for listing doctor details
###
GET http://127.0.0.1:8000/v2/doctors/
Accept: application/json

# api call for creating doctor details
###
POST http://127.0.0.1:8000/v2/doctors/
Content-Type: application/json
Authorization: Basic adminuser:admin

{
    "name":"ajna",
    "specialization":"ent",
    "fee":300,
    "qualification":"MBBS",
    "email":"ajna@gmail.com"
}

# api call for listing one doctor details
###
GET http://127.0.0.1:8000/doctors/1/
Accept: application/json

# api call for deleting one doctor details
###
DELETE http://127.0.0.1:8000/doctors/4/
Accept: application/json

# api call for updating doctor details
###
put http://127.0.0.1:8000/doctors/3/
Content-Type: application/json

{
    "name":"peethambaran",
    "specialization":"urology",
    "fee":-700,
    "qualification":"MBBS",
    "email":"peethambaran@gmail.com"
}

# api call for creating admin user
###
POST http://127.0.0.1:8000/v2/admin-register/
Content-Type: application/json

{
    "username":"adminuser",
    "email":"adminuser@gmail.com",
    "password":"admin"
}

#===========APPOINMENT=============

# api call for listing all apoinments
### 
GET http://127.0.0.1:8000/appoinments/
Accept: application/json

# api call for creating appoinments
###
POST http://127.0.0.1:8000/appoinments/
Content-Type: application/json

{
    "patient_name":"messi",
    "phone":6282758776,
    "doctor":3,
    "appointment_date":"2026-10-1",
    "problem":"ligament issue"
}

####### booking_v2 ##########

# api call for creating authentication
###
POST http://127.0.0.1:8000/v2/booking/signup/
Content-Type: application/json

{
    "username":"django",
    "email":"django@gmail.com",
    "password":"django123"
}

# api call for listing appointments
###
GET http://127.0.0.1:8000/v2/booking/appointmentv2/
Accept: application/json
Authorization: Basic django:django123

# api call for creating appointment
###
POST http://127.0.0.1:8000/v2/booking/appointmentv2/
Content-Type: application/json
Authorization: Basic django:django123

{
    "patient_name":"chinju",
    "phone":6282758777,
    "doctor":3,
    "appointment_date":"2026-10-09",
    "problem":"ego issue"
}

# api call for listing one appointment details
###
GET http://127.0.0.1:8000/v2/booking/appointmentv2/2/
Accept: application/json
Authorization: Basic django:django123

# api call for updating one appointment details
###
PUT http://127.0.0.1:8000/v2/booking/appointmentv2/2/
Content-Type: application/json
Authorization: Basic django:django123

{
  "id": 2,
  "patient_name": "kannan",
  "phone": "628275891",
  "appointment_date": "2026-10-07",
  "token_number": 2,
  "appointment_time": null,
  "problem": "ligament issue",
  "created_at": "2026-10-01T13:20:11.895627Z",
  "doctor": 1
}

# api call for deleting one appointment details
###
DELETE http://127.0.0.1:8000/v2/booking/appointmentv2/3/
Accept: application/json
Authorization: Basic django:django123